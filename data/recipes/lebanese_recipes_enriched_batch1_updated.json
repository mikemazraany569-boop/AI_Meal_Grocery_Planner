      "instructions": [
        {
          "step": 1,
          "text_en": "Prick the aubergines and char them over a gas flame or barbecue, turning until the skins are blackened and the flesh is soft."
        },
        {
          "step": 2,
          "text_en": "Cover briefly to steam, peel, then leave the flesh in a sieve to drain."
        },
        {
          "step": 3,
          "text_en": "Mash the aubergine coarsely; avoid turning it into a completely smooth purée."
        },
        {
          "step": 4,
          "text_en": "Mix with crushed garlic, tahini, lemon juice and salt. Add yoghurt only if desired."
        },
        {
          "step": 5,
          "text_en": "Spread on a plate and finish with olive oil, pomegranate seeds, parsley and a little red pepper."
        }
      ],
      "source": [
        {
          "name": "Gurmestan — Moutabal, Lebanese cuisine",
          "url": "https://gurmestan.com/en/recipes/baba-ghanoush-lubnan/",
