        },
        {
          "name": "Cooking for all Seasons (1994), recipe submitted by Riad Rahal",
          "url": "https://cmosarchives.ca/History/Cooking_for_all_Seasons1994.pdf",
          "source_type": "community_cookbook",
          "used_for": "Historical cross-reference: a recipe titled 'Baba Ghanouj (The Lebanese way)' uses eggplant, tahini, lemon, garlic and salt, with quantities for five people",
          "accessed_date": "2026-11-13"
