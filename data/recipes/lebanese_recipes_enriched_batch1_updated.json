          "step": 1,
          "text_en": "Rinse and drain the fine bulgur, then leave it with half the lemon juice for about 15 minutes to soften."
        },
        {
          "step": 2,
          "text_en": "Remove thick parsley stems. Wash and dry the parsley completely, then finely chop it with a sharp knife. Finely chop the mint as well."
        },
        {
          "step": 3,
          "text_en": "Dice the tomatoes finely and slice the spring onions into thin rings."
        },
        {
          "step": 4,
          "text_en": "Just before serving, combine the bulgur, herbs, tomatoes and onions. Toss gently with the remaining lemon juice, olive oil, spice, salt and pepper."
        },
        {
          "step": 5,
          "text_en": "Serve immediately with lettuce or cabbage leaves."
        }
