      "instructions": [
        {
          "step": 1,
          "text_en": "Soak the dried chickpeas in cold water for 18–24 hours, then drain and dry them thoroughly."
        },
        {
          "step": 2,
          "text_en": "Pulse the chickpeas in a food processor until they resemble coarse crumbs, not a paste."
        },
        {
          "step": 3,
          "text_en": "Add parsley, coriander, spring onions, garlic, cumin, ground coriander and salt; pulse until finely chopped and combined."
        },
        {
          "step": 4,
          "text_en": "Mix in the baking powder and refrigerate the mixture for at least 30 minutes."
        },
        {
          "step": 5,
          "text_en": "Heat the sunflower oil to about 175°C. Shape the mixture into small rounds and press sesame seeds onto the outside."
        },
        {
          "step": 6,
          "text_en": "Fry in batches for 3–4 minutes, turning once, until golden. Drain and serve promptly."
        }
      ],
      "source": [
