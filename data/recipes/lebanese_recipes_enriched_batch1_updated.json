      "instructions": [
        {
          "step": 1,
          "text_en": "Soak the chickpeas overnight in plenty of water."
        },
        {
          "step": 2,
          "text_en": "Drain, coat with half a teaspoon of bicarbonate of soda and stir for about 3 minutes. Add fresh water and simmer for 1–1.5 hours until very soft; skim foam and loose skins."
        },
        {
          "step": 3,
          "text_en": "Blend lemon juice, garlic and salt. Add tahini, then gradually blend in iced water until pale and creamy."
        },
        {
          "step": 4,
          "text_en": "Add the hot cooked chickpeas and blend for 3–4 minutes until smooth, reserving a few chickpeas for garnish."
        },
        {
          "step": 5,
          "text_en": "Spread on a plate, make a shallow well, drizzle with olive oil and garnish with pepper or sumac, parsley and reserved chickpeas."
        }
      ],
